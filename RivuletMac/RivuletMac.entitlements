<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed: the app parses untrusted playlists and streams through
	     FFmpeg, so it keeps to the network and nothing else. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- AetherEngine hands AVPlayer its remuxed video through a local HTTP
	     server (HLSLocalServer). Without this its socket cannot listen, and
	     nothing the engine remuxes plays: Plex direct play, raw MPEG-TS. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
